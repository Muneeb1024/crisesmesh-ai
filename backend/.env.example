# CrisesMesh AI — Backend Environment Variables
# Copy to .env and fill in real values

APP_NAME=CrisesMesh AI Backend
APP_VERSION=0.1.0
DEBUG=true

# CORS — allow mobile Expo dev client
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,*

# Gemini / Google ADK (Day 3)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Supabase (Task 2.2)
SUPABASE_URL=
SUPABASE_KEY=

# Open-Meteo Weather API (free, no key needed)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
